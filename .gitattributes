# Preserve historical documents byte-for-byte on every platform.
docs/history/** -text

# Frozen evaluator hashes cover exact bytes, including older CRLF/mixed files.
# Declare checkout endings so a fresh clone reproduces the measured harness.
/eval/*.py text eol=lf
/eval/evidence.py text eol=crlf
/eval/lexical.py text eol=crlf
/eval/retrieval.py text eol=crlf
/eval/test_compress_model.py -text !eol
