#!/bin/sh
set -eu
# Package managers run as root. Configure the installing user, never root's agents.
task_user=${SUDO_USER:-}
if [ -z "$task_user" ] && [ -n "${PKEXEC_UID:-}" ]; then
  task_user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
fi
if [ -n "$task_user" ] && [ "$task_user" != root ]; then
  runuser -u "$task_user" -- /usr/bin/ixos-engine setup --install --skip-models \
    || echo "Ixos will finish setup when it is first opened." >&2
fi
# Direct root/package-manager installs without a user finish setup on first launch.
