{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ixos",
  "version": "0.1.0",
  "identifier": "com.ixos.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ixos",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "maximized": false,
        "visible": false,
        "focus": true,
        "center": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false,
        "transparent": false,
        "backgroundColor": "#0F0F0E"
      },
      {
        "label": "overlay",
        "title": "Ixos quick search",
        "fullscreen": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "category": "Utility",
    "shortDescription": "Search your code and documents by meaning",
    "longDescription": "Ixos finds files on your computer from a description, using keywords and meaning together. It runs locally on the CPU.",
    "copyright": "Copyright (c) 2026 Ixos Team"
  }
}
