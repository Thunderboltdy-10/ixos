{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ixos",
  "version": "0.1.0",
  "identifier": "com.ixos.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ixos",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "visible": true,
        "focus": true,
        "center": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "category": "Utility",
    "shortDescription": "Local hybrid search",
    "longDescription": "Search local code and documents on CPU.",
    "copyright": "Copyright (c) 2026 Ixos Team"
  }
}
