/* Ixplorer Premium Dark Theme (Complete Restyle) */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #F2F2F7;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #121214;
}

QWidget {
    background-color: transparent;
}

/* Typography Overrides */
#BreadcrumbCurrent, #RailResultTitle, #RailFileName, #CommandPaletteItemTitle {
    font-weight: 600;
    font-size: 13px;
}

#RailResultMeta, #RailSubtleLabel {
    color: #A1A1A6;
    font-size: 11px;
}

#RailResultPath, #RailSnippet, #CommandPaletteItemShortcut {
    font-family: "Geist Mono", "Consolas", monospace;
    font-size: 11px;
    color: #A1A1A6;
}

/* Structural Components */
#AppSidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #17191f, stop:1 #0d0f13);
    border-right: 1px solid #2A2A2C;
}

#ExplorerToolbar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #16181e, stop:1 #101217);
    border-bottom: 1px solid #2A2A2C;
    min-height: 44px;
    max-height: 44px;
}

#StatusStrip {
    background-color: #101217;
    border-top: 1px solid #2A2A2C;
}

#IxosRail {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #15171d, stop:1 #0d0f13);
    border-left: 1px solid #2A2A2C;
}

#DocumentHostRoot {
    background-color: #242426;
    border-radius: 8px;
}

/* Sidebar Styling */
#SidebarSectionHeader {
    background-color: transparent;
    border: none;
    color: #A1A1A6;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 600;
    text-align: left;
    padding: 2px 10px;
}

#SidebarItem {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 6px;
    color: #F2F2F7;
    text-align: left;
    min-height: 30px;
    padding: 0 10px 0 12px;
}

#SidebarItemActive {
    background-color: rgba(255, 255, 255, 0.05);
    border-left: 2px solid #0A84FF;
    border-radius: 6px;
    color: #F2F2F7;
    font-weight: 600;
    text-align: left;
    min-height: 30px;
    padding: 0 10px 0 12px;
}

/* Toolbar Buttons */
#ToolbarNavGroup {
    background: transparent;
    border: none;
}

#ToolbarNavButton {
    background: transparent;
    border: 1px solid transparent;
    color: #A1A1A6;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 8px;
}

#ToolbarNavButton:hover {
    color: #F2F2F7;
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.08);
}

#SearchField {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0 12px;
    min-height: 30px;
    color: #F2F2F7;
}

#SearchField:focus {
    border-color: #0A84FF;
    background-color: #2C2C2E;
}

/* Tab Workspace */
QTabBar::tab {
    background-color: transparent;
    color: #A1A1A6;
    padding: 8px 12px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: none;
    min-height: 24px;
    max-width: 220px;
}

QTabBar::tab:selected {
    background-color: #242426;
    color: #F2F2F7;
    border-top: 2px solid #0A84FF;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 0.03);
}

QTabBar::close-button {
    image: none;
    width: 0;
    height: 0;
}

#TabCloseButton {
    background: transparent;
    border: none;
    color: #8E929C;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0;
    border-radius: 9px;
    font-size: 14px;
}

#TabCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}

#TabAddButton {
    background-color: transparent;
    border: none;
    color: #A1A1A6;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    font-size: 18px;
}

#TabAddButton:hover {
    color: #F2F2F7;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
}

#BreadcrumbButton {
    background: transparent;
    border: none;
    color: #BDBDC2;
    padding: 2px 8px;
    border-radius: 6px;
    text-align: left;
}

#BreadcrumbButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #F2F2F7;
}

#BreadcrumbEdit {
    background-color: #242426;
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    padding: 0 10px;
    min-height: 30px;
}

/* Tree View */
QTreeView {
    background-color: #242426;
    border: none;
    outline: none;
}

QTreeView::item {
    padding: 4px;
    border-radius: 4px;
}

QTreeView::item:selected {
    background-color: rgba(10, 132, 255, 0.15);
    color: #FFFFFF;
}

QTreeView::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Search Cards */
#RailResultCard {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 0 12px;
}

#RailResultCard[active="true"] {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(10, 132, 255, 0.2);
}

#RailDetailPane {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 rgba(255,255,255,0.02), stop:1 rgba(255,255,255,0.00));
}

#RailContextPane {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 rgba(255,255,255,0.028), stop:1 rgba(255,255,255,0.01));
}

#RailContextEyebrow {
    color: #8E8E93;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

#RailContextTitle {
    color: #F2F2F7;
    font-size: 14px;
    font-weight: 600;
}

#RailContextSubtitle {
    color: #A1A1A6;
    font-size: 12px;
}

QPushButton[railPrimaryAction="true"] {
    background-color: rgba(10, 132, 255, 0.16);
    border: 1px solid rgba(10, 132, 255, 0.28);
    border-radius: 8px;
    padding: 5px 10px;
    color: #F2F2F7;
}

QPushButton[railPrimaryAction="true"]:hover {
    background-color: rgba(10, 132, 255, 0.24);
    border-color: rgba(10, 132, 255, 0.42);
}

/* Dropdowns */
QComboBox {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 24px;
}

QComboBox::drop-down {
    border: none;
}

/* Command Palette */
#CommandPalette {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 12px;
}

#CommandPaletteInput {
    background-color: #242426;
    border: 1px solid #0A84FF;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
}

#CommandPaletteList {
    background-color: transparent;
    border: none;
    outline: none;
}

#CommandPaletteList::item {
    background-color: #242426;
    border-radius: 8px;
    margin: 4px 0;
}

#CommandPaletteList::item:selected {
    background-color: #3A3A3C;
    border-left: 3px solid #0A84FF;
}

/* Buttons */
QPushButton {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    border-radius: 6px;
    padding: 6px 12px;
}

#ToolbarPrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #1e68ff, stop:1 #0a84ff);
    border: none;
    color: #FFFFFF;
    border-radius: 10px;
    min-width: 34px;
    max-width: 34px;
    padding: 0;
}

#ToolbarPrimaryButton:hover {
    background-color: #409CFF;
}

#ToolbarGhostButton,
#ToolbarRailButton {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    min-width: 30px;
    max-width: 30px;
    padding: 0;
}

#ToolbarGhostButton:hover,
#ToolbarRailButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

#ToolbarRailButton:checked {
    background-color: rgba(10, 132, 255, 0.24);
    border-color: rgba(10, 132, 255, 0.42);
}

/* Splitter */
QSplitter::handle {
    background-color: #2A2A2C;
}

/* ScrollBars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #3A3A3C;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4C4C4E;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
/* Menus and Tooltips */
QMenu {
    background-color: #242426;
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
    margin: 2px 4px;
}
QMenu::item:selected {
    background-color: #3A3A3C;
    color: #F2F2F7;
}
QMenu::separator {
    height: 1px;
    background-color: #3A3A3C;
    margin: 4px 8px;
}

QToolTip {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 6px;
    padding: 8px 12px;
    color: #F2F2F7;
}

QPushButton:pressed {
    background-color: #4C4C4E;
}
QPushButton:disabled {
    background-color: #1C1C1E;
    color: #6C6C6E;
    border-color: #2A2A2C;
}

#ToolbarPrimaryButton:pressed {
    background: #0A84FF;
}
#ToolbarPrimaryButton:disabled {
    background: #1C1C1E;
    color: #6C6C6E;
}

#ToolbarGhostButton:pressed,
#ToolbarRailButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}
