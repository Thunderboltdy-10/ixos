/* Ixplorer dark theme */

* {
    font-family: "Bahnschrift", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #e5e7eb;
}

QMainWindow,
QWidget {
    background-color: #171a20;
    border: none;
}

/* Toolbar */
#ExplorerToolbar {
    background-color: #12151a;
    border-bottom: 1px solid #20242d;
    min-height: 56px;
    max-height: 56px;
}

#ExplorerToolbar QPushButton {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: #98a2b3;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
    font-size: 16px;
}

#ExplorerToolbar QPushButton:hover {
    background-color: #232833;
    color: #f3f4f6;
}

#ExplorerToolbar QPushButton:disabled {
    color: #4b5563;
}

#SearchField {
    background-color: #1b1f27;
    border: 1px solid #2e3440;
    border-radius: 10px;
    padding: 0 12px;
    min-height: 36px;
    color: #f3f4f6;
    selection-background-color: rgba(20, 184, 166, 0.22);
}

#SearchField:focus {
    background-color: #202632;
    border-color: #14b8a6;
}

#ToolbarCombo {
    background-color: #1b1f27;
    border: 1px solid #2e3440;
    border-radius: 10px;
    padding: 0 10px;
    min-height: 36px;
}

#ToolbarCombo:hover {
    background-color: #202632;
    border-color: #394150;
}

#ToolbarCombo::drop-down {
    border: none;
    width: 22px;
}

#ToolbarCombo QAbstractItemView {
    background-color: #171b23;
    border: 1px solid #2e3440;
    border-radius: 10px;
    outline: none;
    selection-background-color: rgba(20, 184, 166, 0.18);
}

QPushButton#ToolbarPrimaryButton,
QPushButton#ToolbarRailButton,
QPushButton#RailHeaderButton {
    background-color: #1f2430;
    border: 1px solid #323846;
    border-radius: 10px;
    color: #f3f4f6;
    min-width: 84px;
    max-width: 120px;
    min-height: 36px;
    max-height: 36px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#ToolbarPrimaryButton:hover,
QPushButton#ToolbarRailButton:hover,
QPushButton#RailHeaderButton:hover {
    background-color: #262d3a;
    border-color: #3f4757;
}

QPushButton#ToolbarRailButton:checked {
    background-color: rgba(20, 184, 166, 0.14);
    border-color: rgba(20, 184, 166, 0.32);
    color: #7ee7db;
}

/* Breadcrumb */
#BreadcrumbBar {
    background: transparent;
}

#BreadcrumbBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #9ca3af;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 500;
}

#BreadcrumbBar QPushButton:hover {
    background-color: #232833;
    color: #f3f4f6;
}

#BreadcrumbBar QLabel {
    color: #5f6978;
    padding: 0 3px;
}

#BreadcrumbCurrent {
    color: #f3f4f6;
    font-weight: 600;
    padding: 4px 8px;
}

/* Sidebar */
#AppSidebar {
    background-color: #12151a;
    border-right: 1px solid #20242d;
}

#SidebarSectionHeader {
    background: transparent;
    border: none;
    color: #667085;
    font-size: 11px;
    font-weight: 700;
    padding: 22px 18px 8px 18px;
    text-align: left;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

#SidebarSectionHeader:hover {
    color: #94a3b8;
}

#SidebarItem,
#SidebarItemActive {
    border-radius: 9px;
    text-align: left;
    font-size: 13px;
    margin: 2px 10px;
    padding: 8px 12px;
}

#SidebarItem {
    background: transparent;
    border: 1px solid transparent;
    color: #a0a8b5;
}

#SidebarItem:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #f3f4f6;
}

#SidebarItem:disabled {
    color: #556070;
}

#SidebarItemActive {
    background-color: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.24);
    color: #81e6dd;
    font-weight: 600;
}

/* Tabs */
QTabBar {
    background-color: #12151a;
    border-bottom: 1px solid #20242d;
    qproperty-drawBase: false;
}

QTabBar::tab {
    background-color: #12151a;
    color: #7f8795;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 11px 18px;
    min-width: 110px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #1a1e27;
    color: #d1d5db;
}

QTabBar::tab:selected {
    background-color: #171a20;
    color: #f3f4f6;
    border: 1px solid #20242d;
    border-bottom: 1px solid #171a20;
    font-weight: 600;
}

QToolButton#TabAddButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #98a2b3;
    min-width: 32px;
    min-height: 32px;
    margin: 6px;
    font-size: 18px;
}

QToolButton#TabAddButton:hover {
    background-color: #232833;
    color: #f3f4f6;
}

/* Explorer */
QTreeView {
    background-color: #171a20;
    border: none;
    outline: none;
    padding: 10px;
    alternate-background-color: #171a20;
}

QTreeView::item {
    padding: 4px 8px;
    min-height: 32px;
    border-radius: 8px;
    border: 1px solid transparent;
}

QTreeView::item:hover {
    background-color: #202632;
}

QTreeView::item:selected {
    background-color: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
    color: #f3f4f6;
}

QTreeView::item:selected:active {
    background-color: rgba(20, 184, 166, 0.18);
}

QHeaderView {
    background-color: #171a20;
    border: none;
    border-bottom: 1px solid #2b313d;
}

QHeaderView::section {
    background-color: #171a20;
    color: #7f8795;
    border: none;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: #f3f4f6;
    background-color: #1d2230;
}

/* Menus */
QMenu {
    background-color: #171b23;
    border: 1px solid #2e3440;
    border-radius: 12px;
    padding: 8px 0;
}

QMenu::item {
    padding: 8px 38px 8px 18px;
    border-radius: 7px;
    margin: 0 6px;
}

QMenu::item:selected {
    background-color: #262d3a;
}

QMenu::item:disabled {
    color: #5f6978;
}

QMenu::separator {
    background-color: #2b313d;
    height: 1px;
    margin: 6px 12px;
}

/* Rail */
#IxosRail {
    background-color: #12151a;
    border-left: 1px solid #20242d;
}

#RailHeader {
    background-color: #12151a;
    border-bottom: 1px solid #20242d;
}

#RailHeaderTitle {
    color: #f3f4f6;
    font-size: 15px;
    font-weight: 700;
}

#RailHeaderSubtitle {
    color: #94a3b8;
    font-size: 12px;
}

#RailSectionTitle {
    color: #667085;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 22px 18px 8px 18px;
}

#RailFileName {
    color: #f3f4f6;
    font-size: 16px;
    font-weight: 700;
    padding: 4px 18px 2px 18px;
}

#RailLabel {
    color: #9aa4b2;
    font-size: 12px;
    padding: 4px 18px;
}

#RailValueLabel,
#RailSubtleLabel {
    font-size: 13px;
    padding: 4px 18px 8px 18px;
}

#RailValueLabel {
    color: #d1d5db;
}

#RailSubtleLabel {
    color: #94a3b8;
}

#RailStatus {
    color: #d1d5db;
    font-size: 12px;
    padding: 12px 18px 4px 18px;
}

#RailPillRow {
    color: #7ee7db;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 18px 10px 18px;
}

#RailDivider {
    background-color: #20242d;
    min-height: 1px;
    max-height: 1px;
    margin: 18px 18px 0 18px;
}

QListWidget#RailResults {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 14px 8px 14px;
}

QListWidget#RailResults::item {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QFrame#RailResultCard {
    background-color: #1a1f28;
    border: 1px solid #2c3340;
    border-radius: 12px;
}

QFrame#RailResultCard:hover {
    background-color: #202632;
    border-color: #394150;
}

QFrame#RailResultCard[active="true"] {
    background-color: rgba(20, 184, 166, 0.11);
    border-color: rgba(20, 184, 166, 0.34);
}

#RailResultTitle {
    color: #f3f4f6;
    font-size: 14px;
    font-weight: 700;
}

#RailResultMeta {
    color: #9aa4b2;
    font-size: 12px;
}

#RailResultPath {
    color: #7ee7db;
    font-size: 12px;
}

#RailResultSummary {
    color: #d1d5db;
    font-size: 12px;
    line-height: 1.35;
}

QTextEdit#RailSnippet {
    background-color: #0f1318;
    border: 1px solid #262d39;
    border-radius: 10px;
    color: #e5e7eb;
    margin: 8px 18px 0 18px;
    padding: 14px;
    selection-background-color: rgba(20, 184, 166, 0.25);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}

/* Status bar */
#StatusStrip {
    background-color: #12151a;
    border-top: 1px solid #20242d;
    min-height: 30px;
    max-height: 30px;
}

#StatusStrip QLabel {
    color: #8b95a5;
    font-size: 12px;
}

/* Splitter and scrollbars */
QSplitter::handle {
    background-color: #20242d;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: rgba(20, 184, 166, 0.75);
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #394150;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4b5563;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
    height: 0;
}

/* Generic buttons and dialogs */
QPushButton {
    background-color: #1f2430;
    border: 1px solid #323846;
    border-radius: 9px;
    color: #f3f4f6;
    padding: 6px 14px;
    min-height: 30px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #262d3a;
    border-color: #3f4757;
}

QPushButton:pressed {
    background-color: #1b1f27;
}

QPushButton:disabled {
    color: #667085;
    background-color: #171b23;
    border-color: #272d38;
}

QMessageBox {
    background-color: #171a20;
}

QMessageBox QLabel {
    color: #f3f4f6;
    font-size: 14px;
}

QTreeView QLineEdit {
    background-color: #202632;
    border: 1px solid #14b8a6;
    border-radius: 6px;
    color: #f3f4f6;
    padding: 4px 6px;
}

QToolTip {
    background-color: #202632;
    color: #f3f4f6;
    border: 1px solid #323846;
    border-radius: 7px;
    padding: 6px 10px;
}
