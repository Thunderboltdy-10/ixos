/* ═══════════════════════════════════════════════════════════════════
   Ixplorer — Windows 11 Native Aesthetic (Perfect Fidelity)
   Design: High-fidelity Windows 11 Dark Mode reproduction.
   ═══════════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
    font-size: 12px;
    color: #FFFFFF;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #1C1C1C;
}

QWidget {
    background-color: transparent;
}

/* ─── Shell Structure ─── */
#ShellRoot {
    background-color: #1C1C1C;
}

#TopContainer {
    background-color: #272727;
}

#TabBarRow {
    background-color: transparent;
    min-height: 40px;
}

#ExplorerToolbar {
    background-color: #272727; /* Unified with active tab and content */
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

#AppSidebar {
    background-color: #1C1C1C;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

#IxosRail {
    background-color: #1C1C1C;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
}

#StatusStrip {
    background-color: #1C1C1C;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 28px;
}

#StatusStrip QLabel {
    color: #A1A1AA;
    font-size: 11px;
}

/* ─── Tabs (Windows 11 "Page" Effect) ─── */
QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #A1A1AA;
    padding: 8px 20px;
    margin: 4px 2px 0 2px;
    border: 1px solid transparent;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 80px;
    max-width: 240px;
    cursor: pointer;
}

QTabBar::tab:selected {
    background-color: #272727; /* Unified with content */
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid #272727; /* Erase bottom line */
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}

/* ─── Breadcrumb Field ─── */
#BreadcrumbBar {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    min-height: 32px;
}

#BreadcrumbButton {
    border: none;
    background: transparent;
    color: #D4D4D8;
    padding: 0 6px;
    font-size: 13px;
    border-radius: 4px;
}

#BreadcrumbButton:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}

#BreadcrumbCurrent {
    color: #FFFFFF;
    font-weight: 600;
    padding: 0 8px;
}

#BreadcrumbEdit {
    background: transparent;
    border: none;
    color: #FFFFFF;
    padding: 0 10px;
}

/* ─── Sidebar Items (Standard Density) ─── */
#SidebarItem {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #D4D4D8;
    text-align: left;
    min-height: 28px; /* Middle point density */
    max-height: 28px;
    padding: 0 10px;
    margin: 1px 12px;
}

#SidebarItem:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

#SidebarItem[current="true"] {
    background-color: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    font-weight: 600;
}

/* ─── Resume Card ─── */
#SidebarResumeCard {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    margin: 12px 12px 4px 12px;
    padding: 8px;
}

#ResumeCardEyebrow {
    font-size: 9px;
    font-weight: 800;
    color: #F6CA56; /* Amber subtle accent */
    letter-spacing: 0.8px;
}

#ResumeCardTitle {
    font-size: 12px;
    font-weight: 600;
    color: #FFFFFF;
}

#ResumeCardBody {
    font-size: 11px;
    color: #A1A1AA;
}

#ResumeCardButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
}

#ResumeCardButton:hover {
    background: #FFFFFF;
    color: #000000;
}

/* ─── File List (QTreeView Standard Density) ─── */
QTreeView {
    background-color: #272727; 
    border: none;
    show-decoration-selected: 1;
}

QTreeView::item {
    padding: 2px 8px;
    min-height: 30px;
    border: none;
    margin: 0;
}

QTreeView::item:selected {
    background-color: rgba(0, 120, 215, 0.25);
    color: #FFFFFF;
}

QTreeView::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.05);
}

QHeaderView::section {
    background-color: #272727;
    color: #A1A1AA;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 500;
}

/* ─── ScrollBars (Windows 11 Thin) ─── */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.1);
    border: 4px solid transparent;
    border-radius: 6px;
    background-clip: padding-box;
    min-height: 40px;
}
QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.2);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.1);
    border: 4px solid transparent;
    border-radius: 6px;
    background-clip: padding-box;
    min-width: 40px;
}
QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.2);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ─── Home Dashboard ─── */
#HomeDashboardPane {
    background-color: #272727;
}

#DashboardHeader {
    font-size: 22px;
    font-weight: 600;
    color: #FFFFFF;
    padding: 24px 0 8px 0;
}

#DashSectionHeader {
    font-size: 13px;
    font-weight: 600;
    color: #A1A1AA;
    margin-top: 28px;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
}

/* ─── Dashboard Cards ─── */
QPushButton[dashboardCardPrimary="true"] {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 16px;
    text-align: left;
}

QPushButton[dashboardCardPrimary="true"]:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
}

QPushButton[dashboardCard="true"] {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 12px;
    text-align: left;
}

QPushButton[dashboardCard="true"]:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
}

/* ─── Search Field ─── */
#SearchField {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 0 12px;
    min-height: 32px;
    color: #FFFFFF;
}

#SearchField:focus {
    border-color: rgba(0, 120, 215, 0.6);
    background-color: #1C1C1C;
}

/* ─── Buttons ─── */
#ToolbarNavButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}

#ToolbarNavButton:hover {
    background: rgba(255, 255, 255, 0.1);
}

#StatusRailToggle {
    background: transparent;
    border: none;
    border-radius: 4px;
}

#StatusRailToggle:hover {
    background: rgba(255, 255, 255, 0.08);
}

#StatusRailToggle:checked {
    background-color: rgba(255, 255, 255, 0.15);
}

/* ─── Splitter Handle ─── */
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.08);
}
