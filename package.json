{
  "name": "ixos",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first semantic file search",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:dev:watch": "tauri dev",
    "tauri:build": "node scripts/clean-tauri-output.js && tauri build",
    "tauri:build:prod": "node scripts/clean-tauri-output.js && tauri build",
    "dev": "cd ixos-search/ui && npm run dev",
    "build": "cd ixos-search/ui && npm run build",
    "site:dev": "cd ixos-site && npm run dev"
  },
  "workspaces": [
    "ixos-search/ui",
    "packages/ixos-ui",
    "packages/ui",
    "ixos-site"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {}
}
