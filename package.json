{
  "name": "ixos",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first semantic file search",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "tauri": "cd apps/desktop && tauri",
    "tauri:dev": "cd apps/desktop && tauri dev --no-watch",
    "tauri:dev:watch": "cd apps/desktop && tauri dev",
    "tauri:build": "cd apps/desktop && tauri build",
    "tauri:build:prod": "cd apps/desktop && tauri build",
    "dev": "npm run dev --workspace ixos-ui",
    "build": "npm run build --workspace ixos-ui",
    "site:dev": "npm run dev --workspace ixos-site",
    "site:build": "npm run build --workspace ixos-site"
  },
  "workspaces": [
    "apps/desktop/ui",
    "apps/site",
    "packages/ixos-ui",
    "packages/ui"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {}
}
