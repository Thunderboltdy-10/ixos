{
  "name": "ixos",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first semantic file search",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:dev:watch": "tauri dev",
    "tauri:build": "node scripts/verify-desktop-build-env.js && tauri build",
    "tauri:build:prod": "node scripts/verify-desktop-build-env.js && tauri build",
    "dev": "cd ui && npm run dev",
    "build": "cd ui && npm run build",
    "site:dev": "cd ixos-site && npm run dev"
  },
  "workspaces": [
    "ui",
    "packages/ixos-ui",
    "packages/ui",
    "ixos-site"
  ],
  "devDependencies": {
    "@neondatabase/serverless": "0.9.5",
    "@tauri-apps/cli": "^2",
    "drizzle-orm": "^0.36.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@neondatabase/serverless": "0.9.5"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.1"
  }
}
