{
  "suite": "innovation_failure_atlas_v1",
  "description": "Representative failure atlas for Ixos semantic file search trustfulness, retrieval correctness, and stress behavior.",
  "defaults": {
    "directory": "corpus_tiny",
    "format": "json",
    "cache_mode": "memory",
    "limit": 8,
    "top_k": 5,
    "search_mode": "flash",
    "bootstrap_index": true,
    "include_in_volatility": true
  },
  "cases": [
    {
      "id": "exact_anchor_results_streamed_flash",
      "category": "exact_anchor",
      "query": "results streamed",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/logs/app.log"
      ],
      "must_not_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "witness": "app.log line: 2026-01-20 10:00:01 Results streamed",
      "notes": "Exact phrase appears in logs/app.log and should be in top-5 without leaking restricted content."
    },
    {
      "id": "exact_anchor_results_streamed_pro_control",
      "category": "exact_anchor",
      "query": "results streamed",
      "search_mode": "pro",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/logs/app.log"
      ],
      "must_not_include_topk": [],
      "witness": "app.log line: 2026-01-20 10:00:01 Results streamed",
      "notes": "Control case: pro path should recover obvious anchor."
    },
    {
      "id": "semantic_drift_results_streamed_auto_secret",
      "category": "semantic_drift",
      "query": "results streamed",
      "search_mode": "auto",
      "top_k": 5,
      "must_include_topk": [],
      "must_not_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "witness": "restricted/secret.txt contains only 'Restricted data'",
      "notes": "Tests semantic overreach where unrelated restricted file appears for a benign query."
    },
    {
      "id": "exact_anchor_config_json",
      "category": "exact_anchor",
      "query": "config json",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/data/config.json"
      ],
      "must_not_include_topk": [],
      "witness": "config.json includes cache_mode field",
      "notes": "Filename+type anchor should surface real JSON config file."
    },
    {
      "id": "exact_anchor_api_reference_endpoints",
      "category": "exact_anchor",
      "query": "endpoints /search /config /compliance",
      "search_mode": "flash",
      "top_k": 3,
      "must_include_topk": [
        "corpus_tiny/docs/api_reference.md"
      ],
      "must_not_include_topk": [],
      "witness": "api_reference.md lists '/search, /config, /compliance'",
      "notes": "Quoted endpoint tokens should resolve directly to API reference."
    },
    {
      "id": "exact_anchor_privacy_policy",
      "category": "exact_anchor",
      "query": "local-only no telemetry",
      "search_mode": "flash",
      "top_k": 3,
      "must_include_topk": [
        "corpus_tiny/docs/privacy_policy.md"
      ],
      "must_not_include_topk": [],
      "witness": "privacy_policy.md line: Ixos is local-only. No telemetry by default.",
      "notes": "Trust anchor for privacy claims."
    },
    {
      "id": "unicode_anchor_nandu_notes",
      "category": "exact_anchor",
      "query": "ñandú notes",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/nested/level1/level2/über/ñandú_notes.txt"
      ],
      "must_not_include_topk": [],
      "witness": "filename contains unicode terms",
      "notes": "Checks unicode path handling and deep nesting recovery."
    },
    {
      "id": "ambiguous_short_notes",
      "category": "ambiguous_short",
      "query": "notes",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/docs/meeting_notes_2024-11-15.txt"
      ],
      "must_not_include_topk": [],
      "witness": "meeting_notes_2024-11-15.txt contains Notes term",
      "notes": "Ambiguous one-token query should still rank plausible note documents."
    },
    {
      "id": "exact_anchor_meeting_date",
      "category": "exact_anchor",
      "query": "meeting notes 2024-11-15",
      "search_mode": "flash",
      "top_k": 3,
      "must_include_topk": [
        "corpus_tiny/docs/meeting_notes_2024-11-15.txt"
      ],
      "must_not_include_topk": [],
      "witness": "full date and title anchor",
      "notes": "Date-qualified exact anchor should be near deterministic."
    },
    {
      "id": "anchor_project_plan_milestones",
      "category": "exact_anchor",
      "query": "project plan milestones",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/docs/project_plan_2025.md"
      ],
      "must_not_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "witness": "project_plan_2025.md contains milestones intent",
      "notes": "Core trust case: obvious file should be surfaced without privacy leak."
    },
    {
      "id": "pricing_false_negative_flash",
      "category": "semantic_drift",
      "query": "free and pro tiers",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/web/pricing.html"
      ],
      "must_not_include_topk": [],
      "witness": "pricing.html body: Free and Pro tiers.",
      "notes": "Known false negative pattern for lexical/semantic mismatch in flash."
    },
    {
      "id": "pricing_control_pro",
      "category": "exact_anchor",
      "query": "free and pro tiers",
      "search_mode": "pro",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/web/pricing.html"
      ],
      "must_not_include_topk": [],
      "witness": "pricing.html body: Free and Pro tiers.",
      "notes": "Control that pro mode can recover pricing intent."
    },
    {
      "id": "privacy_non_request_no_secret",
      "category": "privacy_guard",
      "query": "roadmap phase",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/markdown/roadmap.md"
      ],
      "must_not_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "witness": "roadmap.md is explicit target",
      "notes": "Restricted file should not appear for unrelated roadmap query."
    },
    {
      "id": "privacy_explicit_secret_request",
      "category": "privacy_guard",
      "query": "restricted data",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "must_not_include_topk": [],
      "witness": "secret.txt content: Restricted data",
      "notes": "When explicitly requested, restricted file should be retrievable."
    },
    {
      "id": "anchor_search_engine_symbol",
      "category": "exact_anchor",
      "query": "search engine",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/code/search_engine.rs"
      ],
      "must_not_include_topk": [],
      "witness": "search_engine.rs comment and symbol names",
      "notes": "Code-symbol style anchor case."
    },
    {
      "id": "large_dir_stress_tauri_command",
      "category": "large_directory_stress",
      "directory": ".",
      "query": "tauri search command",
      "search_mode": "flash",
      "limit": 10,
      "top_k": 10,
      "bootstrap_index": false,
      "include_in_volatility": false,
      "must_include_topk": [
        "src-tauri/src/commands/search.rs"
      ],
      "must_not_include_topk": [],
      "witness": "src-tauri/src/commands/search.rs contains command implementation",
      "notes": "Scale-like stress query on full repo without pre-index bootstrap."
    }
  ]
}
