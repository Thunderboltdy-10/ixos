{
  "suite": "innovation_failure_suite_v1",
  "description": "Compact reproducible failure cases for semantic file-search truthfulness.",
  "defaults": {
    "directory": "corpus_tiny",
    "format": "json",
    "cache_mode": "memory",
    "limit": 5
  },
  "cases": [
    {
      "id": "fn_flash_results_streamed",
      "query": "results streamed",
      "search_mode": "flash",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/logs/app.log"
      ],
      "must_not_include_topk": [],
      "notes": "False negative target: obvious exact phrase in app.log should surface in top-5."
    },
    {
      "id": "fp_auto_results_streamed",
      "query": "results streamed",
      "search_mode": "auto",
      "top_k": 5,
      "must_include_topk": [],
      "must_not_include_topk": [
        "corpus_tiny/restricted/secret.txt"
      ],
      "notes": "False positive target: unrelated restricted file should not rank in top-5."
    },
    {
      "id": "control_pro_results_streamed",
      "query": "results streamed",
      "search_mode": "pro",
      "top_k": 5,
      "must_include_topk": [
        "corpus_tiny/logs/app.log"
      ],
      "must_not_include_topk": [],
      "notes": "Control: Pro mode should at least include the obvious target in top-5."
    }
  ]
}
