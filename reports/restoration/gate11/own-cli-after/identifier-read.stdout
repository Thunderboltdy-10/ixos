{"source_hash":"debb2058484056fbd6c40f01e919312885736d8f943f8cda00b821d15ee1fcb8","total_lines":1094,"truncated":false,"view":{"end_line":911,"path":"mod.rs","start_line":889,"text":"fn identifier_literal(query: &str) -> Option<&str> {\n    let trimmed = query.trim();\n    // Shell quotes disappear before invocation, but JSON can carry them literally.\n    // Treat one matching outer pair as identifier notation; exact punctuation is grep's job.\n    let query = trimmed\n        .strip_prefix('\"')\n        .and_then(|value| value.strip_suffix('\"'))\n        .or_else(|| {\n            trimmed\n                .strip_prefix('\\'')\n                .and_then(|value| value.strip_suffix('\\''))\n        })\n        .unwrap_or(trimmed)\n        .trim();\n    (!query.chars().any(char::is_whitespace)\n        && (query.chars().any(|c| \"_:/\\\\\".contains(c))\n            || query.chars().skip(1).any(char::is_uppercase)\n                && query.chars().any(char::is_lowercase)))\n    .then_some(query)\n}\nfn is_continuation(query: &str) -> bool {\n    let pronouns: HashSet<_> = [\n        \"it\", \"its\", \"they\", \"them\", \"their\", \"that\", \"this\", \"those\","}}
