{"source_hash":"76bb1fbb9ba46dd56b09c2190586a94fcbb5f7ccb120800c46c6c8c8fb600821","total_lines":292,"truncated":false,"view":{"end_line":59,"path":"evidence.rs","start_line":30,"text":"}\n\n#[derive(Debug, Default, Serialize)]\n#[serde(rename_all = \"camelCase\")]\npub struct EvidenceStats {\n    pub policy: EvidencePolicy,\n    pub candidate_passages: usize,\n    pub extra_passages_embedded: usize,\n    pub extra_embed_ms: f64,\n    pub selection_ms: f64,\n}\n\npub(super) struct Selection {\n    pub anchor: usize,\n    pub vector: Vec<f32>,\n}\n\nstruct Candidate {\n    passage: record::Passage,\n    weight: f64,\n    anchor: usize,\n}\n\n// Stable unique-term order avoids HashSet-dependent floating-point ties.\npub(super) fn line_weight(line: &str, idfs: &HashMap<String, f32>) -> f64 {\n    tokens(line)\n        .into_iter()\n        .collect::<BTreeSet<_>>()\n        .iter()\n        .map(|term| f64::from(idfs.get(term).copied().unwrap_or(0.0)))"}}
