{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ixos",
  "version": "0.1.0",
  "identifier": "com.ixos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ixos",
        "width": 1920,
        "height": 1080,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "focus": true,
        "center": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://efuuegbvyq6yzst0.public.blob.vercel-storage.com/installers/latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNzJENzMzNzRCMEU4ODcKUldTSDZMQjBNOWR5K3p4ZUVrd2NLNmk5UDVaTHl6Mkw0VWhydkpSSElSZkkzUHJlUVV1UlFpYVoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../models/ixos-flash-v2/*",
      "../models/potion-base-8M-int8/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "category": "Utility",
    "shortDescription": "Privacy-first semantic file search",
    "longDescription": "Ixos is a privacy-first semantic file search tool that keeps your data local. Search your files by meaning, not just keywords.",
    "copyright": "Copyright (c) 2026 Ixos Team"
  }
}